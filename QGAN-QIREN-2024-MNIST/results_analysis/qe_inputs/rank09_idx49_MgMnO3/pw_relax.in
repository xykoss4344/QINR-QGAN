&CONTROL
   calculation      = 'vc-relax'
   restart_mode     = 'from_scratch'
   outdir           = './out/'
   prefix           = 'qgan_struct'
   pseudo_dir       = './pseudo/'
/
&SYSTEM
   ecutwfc          = 60
   ecutrho          = 480
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'cold'
   ntyp             = 3
   nat              = 5
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-06
   mixing_beta      = 0.7
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
   cell_dynamics    = 'bfgs'
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Mg 24.305 Mg.pbe-n-kjpaw_psl.1.0.0.UPF
Mn 54.938044 Mn.pbe-spn-kjpaw_psl.0.3.1.UPF
O 15.999 O.pbe-n-kjpaw_psl.1.0.0.UPF

K_POINTS automatic
4 4 4  0 0 0

