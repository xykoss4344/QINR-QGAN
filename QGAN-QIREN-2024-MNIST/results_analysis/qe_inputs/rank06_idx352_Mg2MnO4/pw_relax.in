&CONTROL
   calculation      = 'vc-relax'
   restart_mode     = 'from_scratch'
   outdir           = './out/'
   prefix           = 'qgan_struct'
   pseudo_dir       = './pseudo/'
/
&SYSTEM
   ecutwfc          = 60
   ecutrho          = 480
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'cold'
   ntyp             = 3
   nat              = 7
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-06
   mixing_beta      = 0.7
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
   cell_dynamics    = 'bfgs'
/
&FCP
/
&RISM
/
